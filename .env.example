# Copiar este archivo como .env:  cp .env.example .env

# --- Base de datos (MongoDB) ---
# Valores para correr el backend SIN Docker. Con docker compose, el backend
# usa automáticamente mongodb:27017 dentro de la red de Docker.
DB_HOST=localhost
# Puerto de Mongo en la PC (27018 para no chocar con un MongoDB instalado localmente)
DB_PORT=27018
DB_USER=admin
DB_PASSWORD=1234
DB_NAME=tp_integrador

# --- Backend ---
API_PORT=3000
JWT_SECRET=cambiar-esto-por-una-clave-larga-y-secreta
# Duración del token en segundos (28800 = 8 horas)
JWT_EXPIRES_IN_SECONDS=28800

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000/api
